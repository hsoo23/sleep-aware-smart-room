# Host / service configuration
PI_BASE_URL=http://127.0.0.1:5050
PI_TIMEOUT_SECONDS=2.0
LAUNCHER_BASE_URL=http://127.0.0.1:7000
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Fixed-EAR baseline parameters
EAR_THRESHOLD=0.21
DROWSY_SECONDS=2.0
RECOVERY_SECONDS=0.5
FACE_MESH_MAX_NUM_FACES=1
FACE_MESH_REFINE_LANDMARKS=true
FACE_MESH_MIN_DETECTION_CONFIDENCE=0.5
FACE_MESH_MIN_TRACKING_CONFIDENCE=0.5

# Raspberry Pi GPIO
RELAY_PIN=17
BUZZER_PIN=18

# Optional sleep-report email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
