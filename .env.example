# Host / service configuration
PI_BASE_URL=http://127.0.0.1:5050
LAUNCHER_BASE_URL=http://127.0.0.1:7000
CAMERA_INDEX=0

# Fixed-EAR baseline parameters
EAR_THRESHOLD=0.21
DROWSY_SECONDS=2.0
RECOVERY_SECONDS=0.5

# Raspberry Pi GPIO
RELAY_PIN=17
BUZZER_PIN=18

# Optional sleep-report email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

